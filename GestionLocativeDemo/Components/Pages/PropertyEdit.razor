@page "/properties/new"
@page "/properties/edit/{Id:int}"

@using GestionLocativeDemo.Models
@using GestionLocativeDemo.Services

@inject DemoDataService DemoData
@inject NavigationManager Navigation

<PageTitle>@PageTitleText - Gestion Locative</PageTitle>

<div class="property-edit-page">

    <div class="page-header">

        <div>
            <h1>@PageTitleText</h1>

            <p>
                Renseignez les informations du bien immobilier.
            </p>
        </div>

    </div>


    <div class="form-card">

        <div class="form-grid">

            <div class="form-field">
                <label>Type de bien</label>

                <input @bind="_property.TypeBien" />
            </div>


            <div class="form-field">
                <label>Surface (m²)</label>

                <input type="number"
                       step="0.1"
                       @bind="_property.Surface" />
            </div>


            <div class="form-field">
                <label>Étage</label>

                <input type="number"
                       @bind="_property.Etage" />
            </div>


            <div class="form-field">
                <label>Numéro de lot</label>

                <input @bind="_property.NumeroLot" />
            </div>


            <div class="form-field full-width">
                <label>Adresse</label>

                <input @bind="_property.Adresse" />
            </div>


            <div class="form-field">
                <label>Code postal</label>

                <input @bind="_property.CodePostal" />
            </div>


            <div class="form-field">
                <label>Ville</label>

                <input @bind="_property.Ville" />
            </div>


            <div class="form-field full-width">
                <label>Identifiant fiscal</label>

                <input @bind="_property.IdentifiantFiscal" />
            </div>


            <div class="form-field">
                <label>Loyer mensuel (€)</label>

                <input type="number"
                       step="0.01"
                       @bind="_property.Loyer" />
            </div>


            <div class="form-field">
                <label>Charges mensuelles (€)</label>

                <input type="number"
                       step="0.01"
                       @bind="_property.Charges" />
            </div>


            <div class="form-field checkbox-field">

                <label>
                    <input type="checkbox"
                           @bind="_property.EstLoue" />

                    Bien actuellement loué
                </label>

            </div>

        </div>


        <div class="form-actions">

            <button class="cancel-button"
                    @onclick="Cancel">
                Annuler
            </button>

            <button class="save-button"
                    @onclick="Save">
                Enregistrer
            </button>

        </div>

    </div>

</div>


@code {

    [Parameter]
    public int? Id { get; set; }

    private Bien _property = new();

    private bool IsEditMode =>
        Id.HasValue;

    private string PageTitleText =>
        IsEditMode
            ? "Modifier le bien"
            : "Ajouter un bien";


    protected override async Task OnParametersSetAsync() {

        if (!Id.HasValue) {
            _property = new Bien();
            return;
        }

        Bien? existingProperty =
            await DemoData.GetPropertyAsync(Id.Value);

        if (existingProperty == null) {
            Navigation.NavigateTo("/properties");
            return;
        }

        _property = new Bien {
            Id = existingProperty.Id,
            TypeBien = existingProperty.TypeBien,
            Surface = existingProperty.Surface,
            Etage = existingProperty.Etage,
            NumeroLot = existingProperty.NumeroLot,
            Adresse = existingProperty.Adresse,
            CodePostal = existingProperty.CodePostal,
            Ville = existingProperty.Ville,
            IdentifiantFiscal = existingProperty.IdentifiantFiscal,
            Loyer = existingProperty.Loyer,
            Charges = existingProperty.Charges,
            EstLoue = existingProperty.EstLoue
        };
    }


    private void Cancel() {
        Navigation.NavigateTo("/properties");
    }


    private async Task Save() {

        if (IsEditMode) {
            await DemoData.UpdatePropertyAsync(_property);
        }
        else {
            await DemoData.AddPropertyAsync(_property);
        }

        Navigation.NavigateTo("/properties");
    }
}