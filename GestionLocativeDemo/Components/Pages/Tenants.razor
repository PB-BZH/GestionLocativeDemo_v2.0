@page "/Locataires"

@using GestionLocativeDemo.Models
@using GestionLocativeDemo.Services

@inject DemoDataService DemoData
@inject NavigationManager Navigation

<PageTitle>Locataires - Gestion Locative</PageTitle>

<div class="Locataires-page">

    <div class="page-header">

        <div>
            <h1>Locataires</h1>

            <p>
                Gérez les locataires associés à vos biens.
            </p>
        </div>

        <button class="primary-action"
                @onclick="NavigateToAddTenant">
            + Ajouter un locataire
        </button>

    </div>


    <div class="Locataires-summary">

        <span class="summary-value">
            @TenantList.Count
        </span>

        <span class="summary-label">
            locataires enregistrés
        </span>

    </div>


    <div class="Locataires-list">

        @foreach (Locataire tenant in TenantList) {

            <article class="tenant-card">

                <div class="tenant-avatar">
                    @GetInitials(tenant)
                </div>

                <div class="tenant-main">

                    <h2>
                        @tenant.FullName
                    </h2>

                    <div class="tenant-address">
                        @tenant.Address
                    </div>

                    <div class="tenant-contact">

                        <span>
                            @tenant.Email
                        </span>

                        <span>
                            @tenant.Phone
                        </span>

                    </div>

                </div>

                <div class="tenant-actions">

                    <button class="edit-button"
                            @onclick="() => EditTenant(tenant.Id)">
                        Modifier
                    </button>

                </div>

            </article>
        }

    </div>

</div>


@code {

    private List<Locataire> TenantList = [];

    protected override async Task OnInitializedAsync() {

        TenantList =
            await DemoData.GetLocatairesAsync();
    }

    private void NavigateToAddTenant() {
        Navigation.NavigateTo("/Locataires/new");
    }


    private void EditTenant(int id) {
        Navigation.NavigateTo(
            $"/Locataires/edit/{id}");
    }


    private static string GetInitials(
        Locataire tenant) {

        string first =
            string.IsNullOrWhiteSpace(tenant.FirstName)
                ? ""
                : tenant.FirstName[..1];

        string last =
            string.IsNullOrWhiteSpace(tenant.LastName)
                ? ""
                : tenant.LastName[..1];

        return (first + last).ToUpperInvariant();
    }
}